<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found · MolBind</title>
    <link rel="stylesheet" href="/assets/app.css" />
  </head>
  <body class="bg-whiten text-black">
    <main id="main-content" class="mx-auto max-w-xl px-6 py-24 text-center">
      <p class="text-sm font-medium uppercase tracking-wide text-body">Error 404</p>
      <h1 class="mt-2 font-display text-3xl font-semibold">We couldn't find that page</h1>
      <p class="mt-3 text-body">
        The address may be mistyped, or the item may have been moved, deleted or is no longer shared.
      </p>
      <a
        href="/"
        class="mt-6 inline-block rounded-lg bg-accent px-5 py-2 text-white hover:bg-accent-hover"
      >
        Go to the dashboard
      </a>
    </main>
  </body>
</html>
